# Copy this file to .env and adjust if the backend runs elsewhere.
# .env is gitignored and must never be committed.

VITE_API_BASE_URL=http://127.0.0.1:8000

# Shared bearer token sent with every API request; must match the backend's
# API_AUTH_TOKEN (see app/auth.py). This value is baked into the built JS
# bundle at build time and is readable by anyone who inspects the deployed
# site -- it only deters casual/bot abuse of the shared demo dataset, it is
# NOT a real secret once deployed, same limitation VITE_API_BASE_URL already
# has as a build-time-only value.
VITE_API_AUTH_TOKEN=replace-with-the-same-value-as-backend-API_AUTH_TOKEN
