# Copy this file to .env and fill in your local PostgreSQL connection details.
# .env is gitignored and must never be committed.

DATABASE_URL=postgresql+psycopg://expense_classifier:your_password_here@localhost:5432/expense_classifier_dev

# Used only by persistence tests (see docs/development.md). Points at a
# separate, disposable database -- its schema is dropped and recreated on
# every test run, so it must never be the same database as DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://expense_classifier:your_password_here@localhost:5432/expense_classifier_test
